{% extends 'admin/dashboard.html.twig' %}

{% block title %}Users - Admin{% endblock %}

{% block admin_content %}

 

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="page-title">Users Management</h1>
        </div>
        <a href="{{ path('admin_user_new') }}" class="btn btn-primary">
            <i class="fas fa-plus-circle me-2"></i>New User
        </a>
    </div>
    
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="number">{{ total_users|default(0) }}</div>
                <div class="label">Total Users</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card">
                <div class="number">{{ users|filter(u => 'ROLE_ADMIN' in u.roles)|length }}</div>
                <div class="label">Admins</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card">
                <div class="number">{{ users|filter(u => 'ROLE_USER' in u.roles and not ('ROLE_ADMIN' in u.roles))|length }}</div>
                <div class="label">Regular Users</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card">
                <div class="number">{{ users|length }}</div>
                <div class="label">Displayed</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Users</h5>
        <div class="d-flex gap-2">
            <button class="btn btn-outline">
                <i class="fas fa-filter me-2"></i>Filter
            </button>
            <a href="{{ path('admin_user_export_csv') }}" class="btn btn-outline">
                <i class="fas fa-download me-2"></i>Export
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td>{{ user.nom }}</td>
                            <td>{{ user.email }}</td>
                            <td>{{ user.roles ? user.roles|join(', ') : '' }}</td>
                            <td class="text-end">
                                {# <a href="{{ path('admin_user_show', {'id': user.id}) }}" class="action-btn view" title="View">
                                    <i class="fas fa-eye"></i>
                                </a> #}
                                <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="action-btn edit" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}" class="d-inline" onsubmit="return confirm('Delete this user?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                    <button type="submit" class="action-btn delete" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>

                                {% if user.isActive %}
                              <a href="{{ path('admin_user_block', {'id': user.id}) }}" class="action-btn block" title="Block"><i class="fas fa-ban"></i></a>
                                {% else %}
                              <a href="{{ path('admin_user_unblock', {'id': user.id}) }}" class="action-btn unblock" title="Unblock"><i class="fas fa-unlock"></i></a>
                                {% endif %}


                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-4">No users found.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
