{% extends 'base.html.twig' %}

{% block title %}Blog — e-Sports.tn{% endblock %}

{% block body %}
{{ include('components/_page_hero.html.twig', {
    eyebrow: 'Actualités', icon: 'fa-newspaper',
    title: 'Le blog',
    subtitle: 'Résultats, guides et nouveautés de la scène e-sport tunisienne.',
    image: 'img/web/crowd.jpg'
}) }}

<section class="blog_area section_padding" style="background-color: #121a2e; padding: 60px 0;">
    <div class="container">

        <!-- Flash Messages -->
        {% for message in app.flashes('success') %}
            <div class="alert alert-success mb-4" style="background-color: rgba(16, 185, 129, 0.12); color: #a7f3d0; border: 1px solid #c3e6cb; border-radius: 6px; padding: 10px;">
                {{ message }}
            </div>
        {% endfor %}
        
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger mb-4" style="background-color: rgba(239, 68, 68, 0.12); color: #fecaca; border: 1px solid rgba(148, 163, 184, 0.18); border-radius: 6px; padding: 10px;">
                {{ message }}
            </div>
        {% endfor %}

        <!-- Search Bar -->
        <div class="mb-5">
            <form method="GET" action="{{ path('app_blog_user_index') }}" class="row g-2 align-items-center">
                <!-- Title search -->
                <div class="col-sm-6 col-md-6">
                    <input type="text" name="title" class="form-control form-control-lg" 
                           placeholder="Rechercher par titre…" 
                           value="{{ app.request.get('title') }}">
                </div>

                <!-- Date picker -->
                <div class="col-sm-4 col-md-4">
                    <input type="date" name="date" class="form-control form-control-lg" 
                           value="{{ app.request.get('date') }}">
                </div>

                <!-- Search button -->
                <div class="col-sm-2 col-md-2 d-grid">
                    <button class="btn btn-primary btn-lg" type="submit">
                        <i class="bi bi-search"></i> Rechercher
                    </button>
                </div>
            </form>
        </div>

        <div class="row">
            {% if blogs|length > 0 %}
                {% for blog in blogs %}
                    <div class="col-lg-12 mb-5">
                        <div class="d-flex flex-wrap align-items-start shadow-sm rounded-4 overflow-hidden">

                            <!-- LEFT: Image -->
                            <div class="blog-img-wrapper" style="flex: 0 0 35%; min-width: 250px;">
                                {% set img = blog.imageName ?: 'crowd.jpg' %}{% set imgSrc = (img starts with 'http' or img starts with '/') ? img : asset('img/web/' ~ img) %}
                                    <img src="{{ imgSrc }}"
                                         class="img-fluid h-100 w-100"
                                         style="object-fit: cover;"
                                         alt="{{ blog.title }}">
                            </div>

                            <!-- RIGHT: Content -->
                            <div class="blog-content-wrapper p-4" style="flex: 1;">
                                <h1 class="mb-2" style="color: #e2e8f0; font-weight: bold;">{{ blog.title }}</h1>

                                {% if blog.category %}
                                    <p class="text-muted mb-1">{{ blog.category }}</p>
                                {% endif %}
                               <small class="text-muted mb-3 d-block">{{ blog.createdAt|ago }}</small>

                                <!-- ⭐ RATING STARS ONLY -->
                                <div class="mb-3">
                                    {% set avgRating = blog.getAverageRating() %}
                                    {% for i in 1..5 %}
                                        <span style="font-size: 20px; color: {% if i <= avgRating %}#ffc107{% else %}#ccc{% endif %};">★</span>
                                    {% endfor %}
                                </div>

                                <a href="{{ path('app_blog_show', {'id': blog.id}) }}" class="btn btn-primary mt-2">Lire la suite</a>

                                <!-- Comments Toggle Button -->
                                <button class="btn btn-link mt-3 p-0" type="button" onclick="toggleComments('comments-{{ blog.id }}')">
                                    Show/Hide Comments ({{ blog.comments|length }})
                                </button>

                                <!-- Comments Section -->
                                <div id="comments-{{ blog.id }}" class="mt-3" style="display: none; border-top: 1px solid rgba(148, 163, 184, 0.18); padding-top: 15px;">
                                    
                                    {% for comment in blog.comments %}
                                        <div class="comment mb-2" style="color: #e2e8f0;">
                                            <strong>{{ comment.user.nom }}</strong>:
                                            {{ comment.content }}
                                          <small class="ms-1" style="color: #e2e8f0;">{{ comment.createdAt|ago }}</small>
                                        </div>
                                    {% else %}
                                        <p style="color: #e2e8f0;">Aucun commentaire pour le moment.</p>
                                    {% endfor %}

                                    {% if app.user %}
                                        <!-- Formulaire de commentaire avec reCAPTCHA -->
                                        <form action="{{ path('app_blog_comment', {'id': blog.id}) }}" method="POST" class="mt-3">
                                            <div class="mb-2">
                                                <textarea name="content" class="form-control" rows="2" placeholder="Écris ton commentaire…" required></textarea>
                                            </div>
                                            
                                            <!-- 🔐 reCAPTCHA Widget -->
                                            <div class="mb-2">
                                                <div class="g-recaptcha" data-sitekey="{{ app.request.server.get('EWZ_RECAPTCHA_SITE_KEY') | default('6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI') }}"></div>
                                            </div>
                                            
                                            <button type="submit" class="btn btn-primary btn-sm">Publier</button>
                                        </form>
                                    {% else %}
                                        <p class="text-muted mt-2"><em>Connecte-toi pour commenter.</em></p>
                                    {% endif %}
                                </div>

                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <p class="text-center w-100">Aucun article trouvé.</p>
            {% endif %}
        </div>

        {# === AJOUT: PAGINATION === #}
        <div class="navigation d-flex justify-content-center mt-4">
            {{ knp_pagination_render(blogs) }}
        </div>

    </div>
</section>

<!-- 🔐 Script reCAPTCHA Google -->
<script src="https://www.google.com/recaptcha/api.js" async defer></script>

<script>
function toggleComments(id) {
    const el = document.getElementById(id);
    if (el) {
        el.style.display = (el.style.display === 'none' || el.style.display === '') ? 'block' : 'none';
    }
}

// Auto-hide alerts after 5 seconds
document.addEventListener('DOMContentLoaded', function() {
    const alerts = document.querySelectorAll('.alert');
    alerts.forEach(alert => {
        setTimeout(() => {
            alert.style.transition = 'opacity 0.5s';
            alert.style.opacity = '0';
            setTimeout(() => alert.remove(), 500);
        }, 5000);
    });
});
</script>

<style>
/* Style pour le widget reCAPTCHA */
.g-recaptcha {
    margin: 10px 0;
    transform: scale(0.9);
    transform-origin: 0 0;
}

/* Responsive pour mobile */
@media (max-width: 480px) {
    .g-recaptcha {
        transform: scale(0.8);
        transform-origin: 0 0;
    }
}

/* Style pour les commentaires */
.comment {
    background-color: #0f1529;
    padding: 8px;
    border-radius: 6px;
    margin-bottom: 8px;
}

.comment:hover {
    background-color: #0f1529;
}

.btn-primary {
    background-color: #6366f1;
    border-color: #6366f1;
}

.btn-primary:hover {
    background-color: #4f46e5;
    border-color: #4f46e5;
}

.alert {
    animation: slideIn 0.3s ease-out;
}

@keyframes slideIn {
    from {
        transform: translateY(-20px);
        opacity: 0;
    }
    to {
        transform: translateY(0);
        opacity: 1;
    }
}

/* Style pour la pagination */
.navigation .pagination {
    margin: 20px 0;
    padding: 0;
    list-style: none;
    display: flex;
    gap: 5px;
}

.navigation .pagination li {
    display: inline;
}

.navigation .pagination li a,
.navigation .pagination li span {
    display: inline-block;
    padding: 8px 12px;
    background-color: #0f1529;
    border: 1px solid rgba(148, 163, 184, 0.18);
    color: #6366f1;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.3s;
}

.navigation .pagination li.active span {
    background-color: #6366f1;
    border-color: #6366f1;
    color: white;
}

.navigation .pagination li a:hover {
    background-color: #0f1529;
    border-color: rgba(148, 163, 184, 0.18);
    color: #4f46e5;
}

.navigation .pagination li.disabled span {
    color: #94a3b8;
    background-color: #0f1529;
    border-color: rgba(148, 163, 184, 0.18);
    cursor: not-allowed;
}
</style>
<div id="ai-chat-widget" style="position:fixed; bottom:24px; right:24px; width:340px; font-family:sans-serif; z-index:1000;">
    <div style="background:#6366f1; color:white; padding:12px 16px; border-radius:12px 12px 0 0; font-weight:bold;">
        🤖 Blog Assistant
    </div>
    <div id="chat-messages" style="background:#0f1529; height:280px; overflow-y:auto; padding:12px; border-left:1px solid rgba(148, 163, 184, 0.18); border-right:1px solid rgba(148, 163, 184, 0.18); color:#e2e8f0;">
        <p style="color:#94a3b8; font-size:13px;">Pose-moi une question sur les articles du blog !</p>
    </div>
    <div style="display:flex; border:1px solid rgba(148, 163, 184, 0.18); border-radius:0 0 12px 12px; overflow:hidden;">
        <input id="chat-input" type="text" placeholder="Rechercher ou demander…"
               style="flex:1; padding:10px; border:none; outline:none;" />
        <button onclick="sendMessage()" 
                style="background:#6366f1; color:white; border:none; padding:10px 16px; cursor:pointer;">
            ➤
        </button>
    </div>
</div>
<script>
async function sendMessage() {
    const input = document.getElementById('chat-input');
    const messages = document.getElementById('chat-messages');
    const userText = input.value.trim();
    if (!userText) return;
    messages.innerHTML += `<p style="color:#e2e8f0;"><strong>You:</strong> ${userText}</p>`;
    input.value = '';
    messages.innerHTML += `<p id="typing" style="color:#aaa;">AI is thinking...</p>`;
    messages.scrollTop = messages.scrollHeight;
    try {
        const res = await fetch('/blog/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: userText })
        });
        const data = await res.json();
        document.getElementById('typing')?.remove();
        messages.innerHTML += `<p style="color:#e2e8f0;"><strong>🤖 AI:</strong> ${data.reply}</p>`;
    } catch (e) {
        document.getElementById('typing')?.remove();
        messages.innerHTML += `<p style="color:red;">Error contacting AI.</p>`;
    }
    messages.scrollTop = messages.scrollHeight;
}
document.getElementById('chat-input').addEventListener('keydown', e => {
    if (e.key === 'Enter') sendMessage();
});
</script>
{% endblock %}