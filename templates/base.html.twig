<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<title>{% block title %}e-Sports.tn{% endblock %}</title>

<link rel="icon" href="{{ asset('img/favicon.png') }}">

<!-- Bootstrap 4 grid/utilities + legacy template CSS (pages still rely on some of its classes) -->
<link rel="stylesheet" href="{{ asset('css/bootstrap.min.css') }}">
<link rel="stylesheet" href="{{ asset('css/style.css') }}">
<link rel="stylesheet" href="{{ asset('css/riot-stats.css') }}">

<!-- Fonts & icons -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css">

<!-- Site theme: shared palette, components and animations -->
<link rel="stylesheet" href="{{ asset('css/theme.css') }}">

{% block stylesheets %}{% endblock %}
{% block importmap %}{% endblock %}
</head>

<body class="page-enter">

<div class="scroll-progress" aria-hidden="true"></div>

{# ===== Flash messages ===== #}
{% set flashes = app.flashes %}
{% if flashes is not empty %}
<div class="flash-stack" role="status">
    {% for label, messages in flashes %}
        {% set alertClass = label == 'error' ? 'danger' : label %}
        {% for message in messages %}
        <div class="alert alert-{{ alertClass }} d-flex align-items-start gap-2">
            <div class="flex-grow-1">{{ message }}</div>
            <button type="button" class="btn-close btn-close-white ms-2" aria-label="Fermer" onclick="this.closest('.alert').remove()"></button>
        </div>
        {% endfor %}
    {% endfor %}
</div>
{% endif %}

{# ===== Navbar ===== #}
<header class="site-nav">
    <div class="container">
        <a class="site-brand" href="{{ path('app_home') }}">
            <img src="{{ asset('img/Black_and_Green_Illustrative_E-Sports_Gaming_Logo__3_-removebg-preview.png') }}" alt="">
            <span>e-Sports<b>.tn</b></span>
        </a>

        <button class="icon-btn nav-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="siteMenu">
            <i class="fas fa-bars"></i>
        </button>

        <ul class="site-menu" id="siteMenu">
            <li><a class="site-link" href="{{ path('app_home') }}">Accueil</a></li>
            <li><a class="site-link" href="{{ path('app_jeu_index') }}">Jeux</a></li>

            <li class="has-menu" id="tournoiMenu">
                <a class="site-link" href="{{ path('app_tournoi_index') }}" aria-haspopup="true" aria-expanded="false">
                    Tournois <i class="fas fa-chevron-down"></i>
                </a>
                <div class="site-submenu wide">
                    <a href="{{ path('app_tournoi_index') }}"><i class="fas fa-trophy"></i> Tous les tournois</a>
                    <a href="{{ path('app_jeu_stats_page') }}"><i class="fas fa-chart-bar"></i> Statistiques des jeux</a>
                    <a href="{{ path('app_match_game_index') }}"><i class="fas fa-gamepad"></i> Match center</a>
                    <div class="dropdown-stats-container" id="jeu-stats-dropdown">
                        <div class="loading-stats"><i class="fas fa-spinner fa-spin"></i> Chargement des statistiques…</div>
                    </div>
                </div>
            </li>

            <li class="has-menu">
                <a class="site-link" href="{{ path('app_equipe_index') }}" aria-haspopup="true" aria-expanded="false">
                    Équipes <i class="fas fa-chevron-down"></i>
                </a>
                <div class="site-submenu">
                    <a href="{{ path('app_equipe_index') }}"><i class="fas fa-users"></i> Centre des équipes</a>
                    <a href="{{ path('app_equipe_discover') }}"><i class="fas fa-compass"></i> Découvrir les équipes</a>
                    {% if app.user %}
                    <a href="{{ path('app_my_teams') }}"><i class="fas fa-shield-alt"></i> Mes équipes</a>
                    {% endif %}
                </div>
            </li>

            <li><a class="site-link" href="{{ path('app_stats_hub') }}">Stats</a></li>
            <li><a class="site-link" href="{{ path('app_blog_user_index') }}">Blog</a></li>
            <li><a class="site-link" href="{{ path('app_product_index2') }}">Boutique</a></li>
            <li>
                <a class="site-link live" href="{{ path('app_stream_index') }}">
                    <span class="live-dot"></span> LIVE
                </a>
            </li>

            <li class="site-actions">
                {% if app.user %}
                    <a class="icon-btn" href="{{ path('app_wishlist_index') }}" title="Ma wishlist"><i class="fas fa-heart"></i></a>
                {% endif %}
                <a class="icon-btn" href="{{ path('app_cart_index') }}" title="Mon panier">
                    <i class="fas fa-shopping-cart"></i>
                    <span id="cart-count" class="count">0</span>
                </a>
                {% if app.user %}
                    <a class="icon-btn" href="{{ path('app_profile') }}" title="Mon profil"><i class="fas fa-user"></i></a>
                    <a class="icon-btn" href="{{ path('app_logout') }}" title="Déconnexion"><i class="fas fa-sign-out-alt"></i></a>
                {% else %}
                    <a class="btn btn-primary btn-sm px-3" href="{{ path('app_login') }}">Connexion</a>
                {% endif %}
            </li>
        </ul>
    </div>
</header>

{# ===== Page content ===== #}
<main>
{% block body %}{% endblock %}
</main>

{# ===== Footer ===== #}
<footer class="site-footer">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <a class="site-brand mb-3" href="{{ path('app_home') }}">
                    <img src="{{ asset('img/Black_and_Green_Illustrative_E-Sports_Gaming_Logo__3_-removebg-preview.png') }}" alt="">
                    <span>e-Sports<b>.tn</b></span>
                </a>
                <p>La plateforme e-sport tunisienne : tournois, équipes, stats en direct et boutique officielle.</p>
                <div class="footer-social">
                    <a href="#" class="icon-btn" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" class="icon-btn" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                    <a href="#" class="icon-btn" aria-label="Twitch"><i class="fab fa-twitch"></i></a>
                    <a href="#" class="icon-btn" aria-label="Discord"><i class="fab fa-discord"></i></a>
                </div>
            </div>
            <div class="col-lg-2 col-md-6 col-6">
                <h5>Compétition</h5>
                <ul>
                    <li><a href="{{ path('app_tournoi_index') }}">Tournois</a></li>
                    <li><a href="{{ path('app_equipe_index') }}">Équipes</a></li>
                    <li><a href="{{ path('app_jeu_index') }}">Jeux</a></li>
                    <li><a href="{{ path('app_stream_index') }}">Live</a></li>
                </ul>
            </div>
            <div class="col-lg-2 col-md-6 col-6">
                <h5>Communauté</h5>
                <ul>
                    <li><a href="{{ path('app_stats_hub') }}">Stats joueurs</a></li>
                    <li><a href="{{ path('app_blog_user_index') }}">Blog</a></li>
                    <li><a href="{{ path('app_product_index2') }}">Boutique</a></li>
                    <li><a href="{{ app.user ? path('app_profile') : path('app_register') }}">{{ app.user ? 'Mon profil' : 'Créer un compte' }}</a></li>
                </ul>
            </div>
            <div class="col-lg-4 col-md-6">
                <h5>Newsletter</h5>
                <p>Résultats, nouveaux tournois et promos de la boutique, une fois par semaine.</p>
                <form class="newsletter" onsubmit="event.preventDefault(); this.innerHTML = '<p class=&quot;mb-0&quot; style=&quot;color:var(--success)&quot;><i class=&quot;fas fa-check-circle me-2&quot;></i>Merci, à bientôt !</p>';">
                    <input type="email" class="form-control" placeholder="Votre email" required aria-label="Email">
                    <button class="btn btn-primary" type="submit" aria-label="S'inscrire"><i class="far fa-paper-plane"></i></button>
                </form>
            </div>
        </div>
    </div>
    <div class="footer-bottom">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; {{ 'now'|date('Y') }} e-Sports.tn — Tous droits réservés</span>
            <span>Fait avec <i class="fas fa-heart" style="color:var(--danger)"></i> à Tunis</span>
        </div>
    </div>
</footer>

<button class="icon-btn to-top" type="button" aria-label="Retour en haut"><i class="fas fa-arrow-up"></i></button>

<!-- JS: the legacy jQuery plugins targeted the original demo template and were unused -->
<script src="{{ asset('js/theme.js') }}"></script>
<script>
// Cart counter (bumps when the value changes)
function loadCartCount() {
    fetch("{{ path('app_cart_data') }}")
        .then(function (r) { return r.json(); })
        .then(function (data) {
            var el = document.getElementById('cart-count');
            if (!el) return;
            if (el.innerText !== String(data.totalItems)) {
                el.innerText = data.totalItems;
                el.classList.remove('bump'); void el.offsetWidth; el.classList.add('bump');
            }
            el.style.display = data.totalItems > 0 ? '' : 'none';
        })
        .catch(function () {});
}
document.addEventListener('DOMContentLoaded', loadCartCount);

// Game stats inside the Tournois menu, loaded the first time it opens
(function () {
    var menu = document.getElementById('tournoiMenu');
    var container = document.getElementById('jeu-stats-dropdown');
    var loaded = false;
    function load() {
        if (loaded) return;
        loaded = true;
        fetch("{{ path('app_jeu_stats_dropdown') }}")
            .then(function (r) { return r.text(); })
            .then(function (html) { container.innerHTML = html; })
            .catch(function () { container.innerHTML = '<div class="loading-stats" style="color:var(--danger)">Erreur de chargement</div>'; });
    }
    if (menu) {
        menu.addEventListener('mouseenter', load);
        menu.addEventListener('submenu:open', load);
    }
})();
</script>

<style>
    .dropdown-stats-container { max-height: 360px; overflow-y: auto; margin-top: 0.35rem; border-top: 1px solid var(--border); padding-top: 0.35rem; }
    .loading-stats { text-align: center; padding: 1rem; color: var(--muted); font-size: 0.875rem; }
</style>

{% block javascripts %}{% endblock %}
</body>
</html>
