{% extends 'admin/dashboard.html.twig' %}

{% block title %}Orders - Admin{% endblock %}

{% block admin_content %}


<div class="page-header">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="page-title">Orders Management</h1>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="number">{{ totalOrders|default(0) }}</div>
                <div class="label">Total Orders</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card">
                <div class="number">{{ orders|filter(o => o.status == 'pending')|length }}</div>
                <div class="label">Pending Orders</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card">
                <div class="number">{{ orders|filter(o => o.status == 'paid')|length }}</div>
                <div class="label">Paid Orders</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card">
                <div class="number">
                    {{ orders|length > 0 ? (orders|map(o => o.totalPrice)|reduce((acc, v) => acc + v, 0) / orders|length) | number_format(2, '.', ',') : 0 }}
                </div>
                <div class="label">Avg Order Value</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Orders</h5>
        <button class="btn btn-outline"><i class="fas fa-filter me-2"></i>Filter</button>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>User</th>
                        <th>Total Price</th>
                        <th>Status</th>
                        <th>Created At</th>
                    </tr>
                </thead>
                <tbody>
                    {% for order in orders %}
                        <tr>
                            <td>{{ order.orderNumber }}</td>
                            <td>{{ order.user.email }}</td>
                            <td>${{ order.totalPrice|number_format(2, '.', ',') }}</td>
                            <td>
                                {% if order.status == 'pending' %}
                                    <span class="badge badge-pending">Pending</span>
                                {% elseif order.status == 'paid' %}
                                    <span class="badge badge-paid">Paid</span>
                                {% elseif order.status == 'completed' %}
                                    <span class="badge badge-completed">Completed</span>
                                {% elseif order.status == 'canceled' or order.status == 'cancelled' %}
                                    <span class="badge badge-cancelled">Cancelled</span>
                                {% else %}
                                    <span class="badge">{{ order.status|capitalize }}</span>
                                {% endif %}
                            </td>
                            <td>{{ order.createdAt|date('Y-m-d H:i') }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-4">No orders found.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
