{% extends 'base.html.twig' %}

{% block body %}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
@keyframes fadeUp {
    from {opacity:0; transform:translateY(40px);}
    to {opacity:1; transform:translateY(0);}
}

body{
    background: transparent;
}

.main-wrapper{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:50px 0;
}

.register-box{
    width:600px;
    max-width:100%;
    background:#121a2e;
    border-radius:6px;
    padding:40px;
    box-shadow:0 0 30px rgba(0,0,0,.3);
    animation:fadeUp .8s ease;
}

h2{
    font-weight:600;
    margin-bottom:30px;
    text-align:center;
}

.qr-code-container{
    text-align:center;
    margin:30px 0;
}

.qr-code-container img{
    max-width:200px;
    border:5px solid #f8f9fa;
    border-radius:8px;
}

.secret-key{
    background:#0f1529;
    padding:15px;
    border-radius:4px;
    text-align:center;
    font-family:monospace;
    font-size:14px;
    margin:20px 0;
}

.form-control{
    border:none;
    border-bottom:1px solid #aaa;
    border-radius:0;
    transition:.3s;
}

.form-control:focus{
    box-shadow:none;
    border-color:#6366f1;
    padding-left:8px;
}

.btn-primary{
    background:linear-gradient(90deg,#6366f1,#a52bf9);
    border:none;
    padding:12px 30px;
    border-radius:4px;
    transition:.4s;
}

.btn-primary:hover{
    transform:translateY(-2px);
    box-shadow:0 10px 20px rgba(99, 102, 241,.4);
}

.alert{
    font-size:13px;
    animation:fadeUp .6s ease;
}

.back-link{
    text-align:center;
    margin-top:20px;
    display:block;
    color:#6366f1;
    text-decoration:none;
}
</style>

<div class="main-wrapper">

<div class="register-box">

    <h2>Activer l'authentification à deux facteurs</h2>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    <p class="text-center">Scanne ce QR code avec ton application d'authentification (Google Authenticator, Authy…)</p>

    <div class="qr-code-container">
        {% if qrCodeImage %}
            <img src="{{ qrCodeImage }}" alt="QR Code" style="background:white; padding:12px; border-radius:12px;">
        {% else %}
            <div class="alert alert-warning">
                <p>Le QR code n'a pas pu être généré. Utilise la clé secrète ci-dessous.</p>
            </div>
        {% endif %}
    </div>

    <p class="text-center text-muted">Ou entre cette clé manuellement :</p>
    <div class="secret-key">{{ secret }}</div>

    <form method="post" action="{{ path('app_2fa_setup') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('2fa_setup') }}">
        
        <div class="mb-3">
            <label for="2fa_code" class="form-label">Code de vérification</label>
            <input type="text" 
                   name="2fa_code" 
                   class="form-control" 
                   placeholder="123456"
                   required 
                   autofocus
                   maxlength="6"
                   pattern="[0-9]*"
                   inputmode="numeric">
        </div>

        <button type="submit" class="btn btn-primary w-100">Vérifier et activer la 2FA</button>

    </form>

    <a href="{{ path('app_home') }}" class="back-link">Retour à l'accueil</a>

</div>

</div>

{% endblock %}
