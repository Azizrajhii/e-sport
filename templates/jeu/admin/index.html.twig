{% extends 'admin/dashboard.html.twig' %}

{% block extra_css %}
<style>

    .team-logo-mini {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        object-fit: cover;
    }
</style>
{% endblock %}

{% block title %}Games Management - Admin{% endblock %}

{% block admin_content %}
<div class="page-header">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="page-title">Games Management</h1>
            <p class="page-subtitle">Manage esports titles and categories</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('admin_jeu_new') }}" class="btn btn-primary">
                <i class="fas fa-plus-circle me-2"></i>New Game
            </a>
        </div>
    </div>
    
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card stat-card text-center p-3">
                <div class="h2 fw-bold text-primary">{{ jeux|length }}</div>
                <div class="text-muted">Total Games</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card text-center p-3">
                <div class="h2 fw-bold text-success">{{ jeux|filter(j => j.statut == 'ACTIVE')|length }}</div>
                <div class="text-muted">Active Titles</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card text-center p-3">
                <div class="h2 fw-bold text-info">{{ jeux|filter(j => j.statut == 'COMING_SOON')|length }}</div>
                <div class="text-muted">Upcoming</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">All Games</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Genre</th>
                        <th>Platform</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for jeu in jeux %}
                    <tr>
                        <td>#{{ jeu.id }}</td>
                        <td><div class="fw-bold">{{ jeu.nom }}</div></td>
                        <td>{{ jeu.genre }}</td>
                        <td>{{ jeu.plateforme }}</td>
                        <td>
                            <span class="badge {% if jeu.statut == 'ACTIVE' %}bg-success{% elseif jeu.statut == 'COMING_SOON' %}bg-info{% else %}bg-secondary{% endif %}">
                                {{ jeu.statut }}
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="d-flex gap-2 justify-content-end">
                                <a href="{{ path('admin_jeu_show', {'id': jeu.id}) }}" class="action-btn view" title="View"><i class="fas fa-eye"></i></a>
                                <a href="{{ path('admin_jeu_edit', {'id': jeu.id}) }}" class="action-btn edit" title="Edit"><i class="fas fa-edit"></i></a>
                                <form method="post" action="{{ path('admin_jeu_delete', {'id': jeu.id}) }}" class="d-inline" onsubmit="return confirm('Delete this game?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ jeu.id) }}">
                                    <button type="submit" class="action-btn delete" title="Delete"><i class="fas fa-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr><td colspan="6" class="text-center py-4">No games found.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% endblock %}
