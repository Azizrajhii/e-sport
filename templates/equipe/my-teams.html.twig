{% extends 'base.html.twig' %}
{% block title %}Mes équipes — e-Sports.tn{% endblock %}

{% block body %}
{{ include('components/_page_hero.html.twig', {
    eyebrow: 'Mon espace',
    icon: 'fa-shield-alt',
    title: 'Mes équipes',
    subtitle: 'Les équipes que tu diriges et celles dont tu fais partie.',
    image: 'img/web/hero-gamer.jpg',
    actions: [{label: 'Créer une équipe', url: path('app_equipe_new'), icon: 'fa-plus'}]
}) }}
<div class="my-teams-page">

    <!-- STATS -->
    <section class="stats">
        <div class="stat-card">
            <span>👥</span>
            <h3>{{ totalTeams }}</h3>
            <p>Équipes</p>
        </div>

        <div class="stat-card">
            <span>👑</span>
            <h3>{{ ownedTeams|length }}</h3>
            <p>Équipes dirigées</p>
        </div>

        <div class="stat-card">
            <span>🎮</span>
            <h3>{{ joinedTeams|length }}</h3>
            <p>Équipes rejointes</p>
        </div>

        <div class="stat-card">
            <span>🏆</span>
            <h3>{{ globalWinRate }}%</h3>
            <p>Taux de victoire</p>
        </div>
    </section>

    <!-- OWNER TEAMS -->
    <section class="team-section">
        <h2>Équipes que je dirige</h2>

        <div class="teams-grid">
            {% for team in ownedTeams %}
                <a href="{{ path('app_equipe_dashboard', {id: team.id}) }}" class="team-card leader">
                    <div class="team-top">
                        <span class="badge">Capitaine</span>
                    </div>
                    <h3>{{ team.nom }}</h3>
                    <p>{{ team.members|length }} Members</p>
                </a>
            {% else %}
                <p>Tu n'as pas encore créé d'équipe.</p>
            {% endfor %}
        </div>
    </section>

    <!-- MEMBER TEAMS -->
    <section class="team-section">
        <h2>Équipes dont je fais partie</h2>

        <div class="teams-grid">
            {% for team in joinedTeams %}
                <a href="{{ path('app_equipe_dashboard', {id: team.id}) }}" class="team-card">
                    <div class="team-top">
                        <span class="badge player">Membre</span>
                    </div>
                    <h3>{{ team.nom }}</h3>
                    <p>{{ team.members|length }} Members</p>
                </a>
            {% else %}
                <p>Tu n'as rejoint aucune équipe.</p>
            {% endfor %}
        </div>
    </section>

</div>
{% endblock %}

