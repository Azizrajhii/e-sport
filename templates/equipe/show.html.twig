{% extends 'base.html.twig' %}

{% block title %}{{ equipe.nom }} — e-Sports.tn{% endblock %}

{% block stylesheets %}
<style>
    .team-hero .container { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
    .team-hero__logo { width: 104px; height: 104px; border-radius: 24px; object-fit: cover; background: var(--surface-2); border: 1px solid var(--border-strong); box-shadow: var(--glow); display: grid; place-items: center; font-size: 2.5rem; color: var(--muted); }
    .team-hero__meta { display: flex; flex-wrap: wrap; gap: 1rem; color: var(--muted); font-size: 0.9rem; }
    .team-hero__meta i { color: var(--primary-light); margin-right: 0.35rem; }

    .equipe-card { padding: 1.75rem 2rem; margin-bottom: 1.5rem; }
    .equipe-card h3 { font-size: 1.15rem; margin: 0 0 1rem; display: flex; align-items: center; gap: 0.5rem; }
    .equipe-card h3 i { color: var(--primary-light); }
    .items-list { display: flex; flex-wrap: wrap; gap: 0.6rem; }
    .chip { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.5rem 0.9rem; border-radius: 999px; font-size: 0.875rem; font-weight: 500; background: rgba(148, 163, 184, 0.1); border: 1px solid var(--border); color: var(--text); transition: all 0.2s var(--ease); }
    .chip:hover { border-color: rgba(99, 102, 241, 0.5); color: #fff; }
    .chip.tournament { background: rgba(99, 102, 241, 0.14); border-color: rgba(99, 102, 241, 0.3); color: #c7d2fe; }
    .chip .avatar { width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; font-size: 0.7rem; font-weight: 700; color: #fff; background: var(--grad); }
    .chip .owner { color: var(--warning); font-size: 0.75rem; }
    .empty-msg { color: var(--muted); font-style: italic; margin: 0; }
    .danger-zone { border-color: rgba(239, 68, 68, 0.35); }
    .danger-zone h3, .danger-zone h3 i { color: #fca5a5; }
</style>
{% endblock %}

{% block body %}
<section class="page-hero team-hero" style="--hero-img: url('{{ asset('img/web/tournament-stage.jpg') }}')">
    <div class="container">
        {% if equipe.logo %}
            <img class="team-hero__logo float" src="{{ asset('uploads/teams/' ~ equipe.logo) }}" alt="">
        {% else %}
            <div class="team-hero__logo"><i class="fas fa-users"></i></div>
        {% endif %}
        <div>
            <span class="eyebrow"><i class="fas fa-shield-alt"></i> Équipe #{{ equipe.id }}</span>
            <h1>{{ equipe.nom }}</h1>
            <div class="team-hero__meta">
                <span><i class="fas fa-crown"></i>Capitaine : {{ equipe.owner.nom }}</span>
                <span><i class="fas fa-users"></i>{{ equipe.members|length }} / {{ equipe.maxMembers }} membres</span>
                <span><i class="fas fa-trophy"></i>{{ equipe.tournois|length }} tournoi{{ equipe.tournois|length > 1 ? 's' }}</span>
            </div>
        </div>
    </div>
</section>

<div class="container">
    <div class="row">
        <div class="col-lg-6">
            <div class="card equipe-card">
                <h3><i class="fas fa-users"></i> Membres</h3>
                {% if equipe.members|length > 0 %}
                    <div class="items-list">
                        {% for member in equipe.members %}
                            <span class="chip">
                                <span class="avatar">{{ member.nom|first|upper }}</span>
                                {{ member.nom }}
                                {% if equipe.owner and member.id == equipe.owner.id %}<i class="fas fa-crown owner" title="Capitaine"></i>{% endif %}
                            </span>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="empty-msg">Aucun membre pour le moment.</p>
                {% endif %}
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card equipe-card">
                <h3><i class="fas fa-trophy"></i> Tournois</h3>
                {% if equipe.tournois|length > 0 %}
                    <div class="items-list">
                        {% for tournament in equipe.tournois %}
                            <a class="chip tournament" href="{{ path('app_tournoi_show', {id: tournament.id}) }}">{{ tournament.nom }}</a>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="empty-msg">Pas encore inscrite à un tournoi.</p>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <a href="{{ path('app_equipe_index') }}" class="btn btn-outline-light"><i class="fas fa-arrow-left mr-2"></i> Retour aux équipes</a>
        <a href="{{ path('app_equipe_edit', {'id': equipe.id}) }}" class="btn btn-primary"><i class="fas fa-edit mr-2"></i> Modifier l'équipe</a>
    </div>

    <div class="card equipe-card danger-zone">
        <h3><i class="fas fa-exclamation-triangle"></i> Zone de danger</h3>
        {{ include('equipe/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
