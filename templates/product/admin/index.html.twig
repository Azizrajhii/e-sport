{% extends 'admin/dashboard.html.twig' %}

{% block title %}Products - Admin{% endblock %}

{% block admin_content %}

 

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="page-title">Products Management</h1>
        </div>
        <a href="{{ path('admin_product_new') }}" class="btn btn-primary">
            <i class="fas fa-plus-circle me-2"></i>New Product
        </a>
    </div>
    
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="number">{{ total_products|default(0) }}</div>
                <div class="label">Total Products</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card">
                <div class="number">{{ products|filter(p => p.stock > 0)|length }}</div>
                <div class="label">In Stock</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card">
                <div class="number">{{ products|filter(p => p.stock <= 0)|length }}</div>
                <div class="label">Out of Stock</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card">
                <div class="number">
                    {{ ((products|map(p => p.price)|reduce((acc, v) => acc + v, 0)) / (products|length > 0 ? products|length : 1))|number_format(2, '.', ',') }} <small>TND</small>
                </div>
                <div class="label">Avg Price</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Products</h5>
        <div class="d-flex gap-2">
            <button class="btn btn-outline">
                <i class="fas fa-filter me-2"></i>Filter
            </button>
            <a href="{{ path('admin_user_export_csv') }}" class="btn btn-outline">
                <i class="fas fa-download me-2"></i>Export
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>category</th>
                        <th>price</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for product in products %}
                        <tr>
                            <td>{{ product.name }}</td>
                            <td>{{ product.description }}</td>
                            <td>{{ product.category ? product.category.name : '' }}</td>
                            <td>{{ product.price ? product.price|number_format(2, '.', ',') ~ ' TND' : '' }}</td>
                            <td class="text-end">
                                <a href="{{ path('admin_product_show', {'id': product.id}) }}" class="action-btn view" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('admin_product_edit', {'id': product.id}) }}" class="action-btn edit" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="post" action="{{ path('admin_product_delete', {'id': product.id}) }}" class="d-inline" onsubmit="return confirm('Delete this product?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                                    <button type="submit" class="action-btn delete" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-4">No products found.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
