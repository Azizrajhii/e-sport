{% extends 'base.html.twig' %}

{% block title %}Boutique — e-Sports.tn{% endblock %}

{% block body %}

<!-- breadcrumb start -->
{{ include('components/_page_hero.html.twig', {
    eyebrow: 'Boutique officielle', icon: 'fa-store',
    title: 'Boutique',
    subtitle: 'Maillots, périphériques et accessoires pour équiper ta team.',
    image: 'img/web/product-mousepad.jpg'
}) }}
<!-- breadcrumb end -->

<style>
    .shop { padding-bottom: 2rem; }

    .shop-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.75rem; }
    .shop-toolbar h2 { font-size: 1.6rem; margin: 0; }
    .shop-toolbar small { color: var(--muted); }
    .shop-search { display: flex; gap: 0.5rem; width: min(420px, 100%); }
    .shop-search input { flex: 1; min-width: 0; padding: 0.7rem 1rem; }

    .shop-sidebar { position: sticky; top: calc(var(--nav-h) + 1rem); padding: 1.25rem; }
    .shop-sidebar h3 { font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin: 0 0 0.75rem; }
    .category-item { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.65rem 0.8rem; border-radius: 10px; color: var(--text); font-weight: 500; transition: background 0.2s, color 0.2s; }
    .category-item:hover { background: rgba(99, 102, 241, 0.12); color: #fff; }
    .category-item.active { background: rgba(99, 102, 241, 0.2); color: #fff; box-shadow: inset 3px 0 0 var(--primary); }
    .category-item .count { min-width: 26px; padding: 0.1rem 0.45rem; border-radius: 999px; background: rgba(148, 163, 184, 0.14); color: var(--muted); font-size: 0.75rem; text-align: center; }

    .product-card { display: flex; flex-direction: column; height: 100%; overflow: hidden; }
    .product-card__media { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--surface-2); }
    .product-card__media img { width: 100%; height: 100%; object-fit: cover; }
    .product-card__tag { position: absolute; top: 12px; left: 12px; background: rgba(11, 16, 32, 0.78) !important; color: #c7d2fe !important; backdrop-filter: blur(6px); border: 1px solid rgba(99, 102, 241, 0.35); }
    .product-card__wish { position: absolute; top: 10px; right: 10px; width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: rgba(11, 16, 32, 0.7); backdrop-filter: blur(6px); color: #fff; border: 1px solid var(--border); transition: transform 0.2s var(--ease), color 0.2s; }
    .product-card__wish:hover { transform: scale(1.1); color: #fca5a5; }
    .product-card__wish.on { color: var(--danger); }
    .product-card__body { display: flex; flex-direction: column; gap: 0.4rem; padding: 1.1rem 1.2rem 1.25rem; flex: 1; }
    .product-card__body h3 { font-size: 1.15rem; margin: 0; }
    .product-card__body h3 a { color: #fff; }
    .product-card__body h3 a:hover { color: var(--primary-light); }
    .product-card__body p { color: var(--muted); font-size: 0.875rem; margin: 0; }
    .product-card__foot { margin-top: auto; padding-top: 0.75rem; display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
    .product-card__price { font-family: var(--font-display); font-size: 1.45rem; font-weight: 700; color: #fff; white-space: nowrap; }
    .product-card__price small { font-size: 0.8rem; color: var(--muted); }
    .stock-low { color: var(--warning); font-size: 0.75rem; font-weight: 600; }

    .btn-buy { white-space: nowrap; }
    .btn-buy.loading { opacity: 0.7; pointer-events: none; }
    .btn-buy.success { background: var(--success) !important; box-shadow: 0 8px 24px rgba(16, 185, 129, 0.35); }

    .shop .pagination { justify-content: center; gap: 0.35rem; margin-top: 2rem; }
    .shop .page-link { border-radius: 10px !important; min-width: 40px; text-align: center; }

    .empty-shop { padding: 3rem 1rem; text-align: center; color: var(--muted); border: 1px dashed var(--border-strong); border-radius: var(--radius); }
    .empty-shop i { font-size: 2rem; color: var(--primary-light); margin-bottom: 0.75rem; display: block; }

    .toast-cart { position: fixed; right: 20px; bottom: 90px; z-index: 1060; display: flex; gap: 0.75rem; align-items: center; padding: 0.9rem 1.1rem; border-radius: 14px; background: var(--surface); border: 1px solid rgba(16, 185, 129, 0.4); box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45); animation: toast-in 0.4s var(--ease) both; max-width: calc(100vw - 40px); }
    .toast-cart i { color: var(--success); font-size: 1.3rem; }
    .toast-cart.leaving { animation: toast-out 0.35s var(--ease) both; }
</style>

{% set currentCategory = app.request.attributes.get('_route') == 'app_product_by_category_index2' ? app.request.attributes.get('id') : null %}

<div class="container shop">
    <div class="shop-toolbar">
        <div>
            <h2>{{ currentCategory ? (categories|filter(c => c.id == currentCategory)|first).name|default('Produits') : 'Tous les produits' }}</h2>
            <small>{{ products.getTotalItemCount is defined ? products.getTotalItemCount : products|length }} produit(s)</small>
        </div>
        <form method="get" action="{{ path('app_product_index2') }}" class="shop-search" role="search">
            <input type="search" name="search" value="{{ searchTerm|default(app.request.query.get('search')) }}" class="form-control" placeholder="Rechercher un produit…" aria-label="Rechercher un produit">
            <button class="btn btn-primary" type="submit" aria-label="Rechercher"><i class="fas fa-search"></i></button>
        </form>
    </div>

    <div class="row g-4">
        <aside class="col-lg-3">
            <nav class="card shop-sidebar" aria-label="Catégories">
                <h3>Catégories</h3>
                <a href="{{ path('app_product_index2') }}" class="category-item {{ currentCategory ? '' : 'active' }}">
                    <span><i class="fas fa-th-large mr-2"></i>Tout voir</span>
                </a>
                {% for category in categories %}
                    <a href="{{ path('app_product_by_category_index2', {id: category.id}) }}" class="category-item {{ currentCategory == category.id ? 'active' }}">
                        <span>{{ category.name }}</span>
                        <span class="count">{{ category.products|length }}</span>
                    </a>
                {% endfor %}
            </nav>
        </aside>

        <div class="col-lg-9">
            <div class="row g-4">
                {% for product in products %}
                    <div class="col-md-6 col-xl-4">
                        <article class="card product-card">
                            <a href="{{ path('app_product_show', {id: product.id}) }}" class="product-card__media">
                                <img src="{{ product.image ?: asset('img/web/product-giftcard.jpg') }}" alt="{{ product.name }}" loading="lazy">
                                <span class="product-card__tag badge bg-primary">{{ product.category.name }}</span>
                            </a>
                            {% if app.user %}
                                <a href="{{ path('app_wishlist_toggle', {id: product.id}) }}" class="product-card__wish {{ product.id in wishlistIds ? 'on' }}" title="{{ product.id in wishlistIds ? 'Retirer de la wishlist' : 'Ajouter à la wishlist' }}">
                                    <i class="{{ product.id in wishlistIds ? 'fas' : 'far' }} fa-heart"></i>
                                </a>
                            {% endif %}
                            <div class="product-card__body">
                                <h3><a href="{{ path('app_product_show', {id: product.id}) }}">{{ product.name }}</a></h3>
                                <p>{{ product.description|length > 80 ? product.description|slice(0, 80) ~ '…' : product.description }}</p>
                                {% if product.stock > 0 and product.stock <= 5 %}<span class="stock-low"><i class="fas fa-bolt mr-1"></i>Plus que {{ product.stock }} en stock</span>{% endif %}
                                <div class="product-card__foot">
                                    <span class="product-card__price">{{ product.price|number_format(2, ',', ' ') }} <small>TND</small></span>
                                    {% if app.user %}
                                        {% if product.stock > 0 %}
                                            <button class="btn btn-primary btn-sm btn-buy add-to-cart-btn" type="button"
                                                    data-product-id="{{ product.id }}"
                                                    data-product-name="{{ product.name }}"
                                                    data-product-price="{{ product.price }}">
                                                <i class="fas fa-cart-plus mr-1"></i> Ajouter
                                            </button>
                                        {% else %}
                                            <span class="badge bg-secondary">Rupture</span>
                                        {% endif %}
                                    {% else %}
                                        <a href="{{ path('app_login') }}" class="btn btn-outline-light btn-sm">Connexion</a>
                                    {% endif %}
                                </div>
                            </div>
                        </article>
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="empty-shop"><i class="fas fa-box-open"></i>Aucun produit ne correspond à ta recherche.</div>
                    </div>
                {% endfor %}
            </div>
            {{ knp_pagination_render(products) }}
        </div>
    </div>
</div>
<div id="chatbot-bubble" onclick="toggleChat()">🎮</div>

<div id="chatbot-box">
    <div id="chatbot-header">
        🎮 Assistant Gaming
        <button onclick="resetChat()">🔄</button>
    </div>
    <div id="chatbot-messages"></div>
    <div id="chatbot-input-area">
        <input type="text" id="chatbot-input" placeholder="Pose ta question..."
               onkeypress="if(event.key==='Enter') sendChatMessage()">
        <button onclick="sendChatMessage()">➤</button>
    </div>
</div>

<style>
#chatbot-bubble{position:fixed;bottom:80px;right:20px;width:56px;height:56px;background:linear-gradient(135deg,#6366f1,#8b5cf6);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:28px;cursor:pointer;box-shadow:0 4px 15px rgba(99,102,241,.5);z-index:9999;}
#chatbot-box{display:none;position:fixed;bottom:100px;right:30px;width:350px;height:480px;background:#1a1a2e;border-radius:16px;box-shadow:0 8px 32px rgba(0,0,0,.4);z-index:9998;flex-direction:column;overflow:hidden;border:1px solid #6366f1;}
#chatbot-header{background:#6366f1;color:#fff;padding:14px 16px;font-weight:700;display:flex;justify-content:space-between;align-items:center;}
#chatbot-header button{background:none;border:none;color:#fff;cursor:pointer;font-size:16px;}
#chatbot-messages{overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:10px;height:340px;}
.msg-user{background:#6366f1;color:#fff;padding:10px 14px;border-radius:18px 18px 4px 18px;align-self:flex-end;max-width:80%;font-size:14px;}
.msg-bot{background:#2a2a4a;color:#e0e0e0;padding:10px 14px;border-radius:18px 18px 18px 4px;align-self:flex-start;max-width:80%;font-size:14px;line-height:1.5;}
#chatbot-input-area{display:flex;padding:10px;border-top:1px solid #333;gap:8px;}
#chatbot-input{flex:1;padding:10px;border-radius:20px;border:1px solid #6366f1;background:#2a2a4a;color:#fff;outline:none;font-size:13px;}
#chatbot-input-area button{background:#6366f1;color:#fff;border:none;border-radius:50%;width:38px;height:38px;cursor:pointer;font-size:16px;}
</style>

<script>
function toggleChat(){
    const box=document.getElementById('chatbot-box');
    box.style.display=box.style.display==='flex'?'none':'flex';
    if(box.style.display==='flex'){
        document.getElementById('chatbot-input').focus();
        if(document.getElementById('chatbot-messages').children.length === 0){
            appendMessage('bot', '👋 Bonjour ! Je suis votre assistant gaming 🎮 Comment puis-je vous aider ? Je peux vous conseiller sur nos produits, vérifier les prix ou le stock !');
        }
    }
}
async function sendChatMessage(){
    const input=document.getElementById('chatbot-input');
    const message=input.value.trim();
    if(!message) return;
    appendMessage('user',message);
    input.value='';
    const loader=appendMessage('bot','⏳...');
    try {
        const res=await fetch('/chatbot/message',{
            method:'POST',
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({message})
        });
        const data=await res.json();
        loader.textContent=data.response||data.error;
    } catch(e){
        loader.textContent='Erreur de connexion.';
    }
    scrollToBottom();
}
async function resetChat(){
    await fetch('/chatbot/reset',{method:'POST'});
    document.getElementById('chatbot-messages').innerHTML='';
}
function appendMessage(role,text){
    const div=document.createElement('div');
    div.className=role==='user'?'msg-user':'msg-bot';
    div.textContent=text;
    document.getElementById('chatbot-messages').appendChild(div);
    scrollToBottom();
    return div;
}
function scrollToBottom(){
    const msgs=document.getElementById('chatbot-messages');
    msgs.scrollTop=msgs.scrollHeight;
}
</script>
<!-- JavaScript for Add to Cart -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    
    // Handle Add to Cart button clicks
    document.addEventListener('click', function(e) {
        if (e.target.classList.contains('add-to-cart-btn') || 
            e.target.closest('.add-to-cart-btn')) {
            
            e.preventDefault();
            e.stopPropagation();
            
            const button = e.target.classList.contains('add-to-cart-btn') 
                ? e.target 
                : e.target.closest('.add-to-cart-btn');
            
            const productId = button.getAttribute('data-product-id');
            const productName = button.getAttribute('data-product-name');
            const productPrice = button.getAttribute('data-product-price');
            
            // Disable button and show loading state
            button.disabled = true;
            const originalHTML = button.innerHTML;
            button.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            button.classList.add('loading');
            
            // Send AJAX request
            // build URL using Symfony router to respect base path
            const addUrl = '{{ path('app_cart_add', {'id':'__ID__'}) }}'.replace('__ID__', productId);
            fetch(addUrl, {
                method: 'POST',
                credentials: 'same-origin',      // ensure session cookie is sent
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ quantity: 1 })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Update cart badge
                    updateCartBadge(data.cartTotal);
                    
                    // Show success state
                    button.innerHTML = '<i class="fas fa-check mr-1"></i> Ajouté';
                    button.classList.remove('loading');
                    button.classList.add('success');

                    // Show notification and refresh the navbar counter
                    showNotification('Ajouté au panier', productName);
                    if (typeof loadCartCount === 'function') loadCartCount();
                    
                    // Reset button after 2 seconds
                    setTimeout(() => {
                        button.innerHTML = originalHTML;
                        button.classList.remove('success');
                        button.disabled = false;
                    }, 2000);
                    
                } else {
                    showNotification('Erreur', data.message || "Impossible d'ajouter ce produit.", true);
                    button.innerHTML = originalHTML;
                    button.classList.remove('loading');
                    button.disabled = false;
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showNotification('Erreur', 'Une erreur est survenue. Réessaie.', true);
                button.innerHTML = originalHTML;
                button.classList.remove('loading');
                button.disabled = false;
            });
        }
    });
    
    // Update cart badge
    function updateCartBadge(total) {
        let badge = document.getElementById('cart-badge');
        if (badge) {
            badge.innerText = total;
            // Animate
            badge.style.transform = 'scale(1.5)';
            setTimeout(() => {
                badge.style.transform = 'scale(1)';
            }, 300);
        }
    }
    
    // Show success notification
    function showNotification(title, message, isError) {
        const notification = document.createElement('div');
        notification.className = 'toast-cart';
        if (isError) notification.style.borderColor = 'rgba(239, 68, 68, 0.5)';
        notification.innerHTML = '<i class="fas"></i><div><strong></strong><br><small class="text-muted"></small></div>';
        notification.querySelector('i').classList.add(isError ? 'fa-exclamation-circle' : 'fa-check-circle');
        if (isError) notification.querySelector('i').style.color = 'var(--danger)';
        notification.querySelector('strong').textContent = title;
        notification.querySelector('small').textContent = message;
        document.body.appendChild(notification);
        setTimeout(() => {
            notification.classList.add('leaving');
            setTimeout(() => notification.remove(), 350);
        }, 3000);
    }
    
    // Load cart count on page load
    fetch('/cart/data')
        .then(response => response.json())
        .then(data => {
            updateCartBadge(data.totalItems);
        })
        .catch(error => console.error('Error loading cart data:', error));
});
</script>

{% endblock %}
