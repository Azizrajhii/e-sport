{% extends 'base.html.twig' %}

{% block title %}{{ tournoi ? tournoi.nom : 'Match center' }} — e-Sports.tn{% endblock %}

{% block stylesheets %}
<style>
    .mc-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem; }
    .mc-filter { padding: 0.5rem 1rem; border-radius: 999px; border: 1px solid var(--border-strong); background: rgba(148, 163, 184, 0.06); color: var(--muted); font-weight: 600; font-size: 0.875rem; transition: all 0.2s var(--ease); }
    .mc-filter:hover { color: #fff; border-color: var(--primary); }
    .mc-filter.active { background: var(--grad); border-color: transparent; color: #fff; box-shadow: 0 8px 24px rgba(99, 102, 241, 0.3); }
    .mc-filter .n { margin-left: 0.35rem; opacity: 0.75; font-variant-numeric: tabular-nums; }

    .match { display: flex; flex-direction: column; height: 100%; }
    .match__head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.9rem 1.1rem; border-bottom: 1px solid var(--border); font-size: 0.8rem; }
    .match__tournament { color: var(--accent); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .match__date { color: var(--muted); white-space: nowrap; }
    .match__body { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 0.75rem; padding: 1.4rem 1.1rem; }
    .match__team { display: flex; flex-direction: column; align-items: center; gap: 0.55rem; text-align: center; min-width: 0; }
    .match__logo { width: 56px; height: 56px; border-radius: 16px; object-fit: cover; background: var(--surface-2); border: 1px solid var(--border); display: grid; place-items: center; color: var(--muted); font-size: 1.2rem; }
    .match__team strong { color: #fff; font-size: 0.95rem; line-height: 1.2; overflow-wrap: anywhere; }
    .match__team.win .match__logo { border-color: rgba(16, 185, 129, 0.6); box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15); }
    .match__team.win strong { color: #a7f3d0; }
    .match__team.lose { opacity: 0.6; }
    .match__score { font-family: var(--font-display); font-size: 2rem; font-weight: 700; color: #fff; letter-spacing: 0.06em; white-space: nowrap; }
    .match__vs { font-family: var(--font-display); font-size: 1.3rem; font-weight: 700; color: var(--muted-2); padding: 0.4rem 0.8rem; border: 1px dashed var(--border-strong); border-radius: 10px; }
    .match__foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.1rem; border-top: 1px solid var(--border); }
    .match__foot a { font-weight: 600; font-size: 0.875rem; }
    .status-live { background: rgba(239, 68, 68, 0.18) !important; color: #fecaca !important; }
    .status-live::before { content: ''; display: inline-block; width: 7px; height: 7px; margin-right: 6px; border-radius: 50%; background: var(--danger); animation: live-pulse 1.6s infinite; vertical-align: 1px; }

    .standings td, .standings th { padding: 0.75rem 0.9rem; text-align: center; vertical-align: middle; }
    .standings td:nth-child(2), .standings th:nth-child(2) { text-align: left; }
    .standings .rank { display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 9px; background: rgba(148, 163, 184, 0.12); font-weight: 700; }
    .standings tr:nth-child(1) .rank { background: linear-gradient(135deg, #fbbf24, #f59e0b); color: #111; }
    .standings tr:nth-child(2) .rank { background: linear-gradient(135deg, #e2e8f0, #94a3b8); color: #111; }
    .standings tr:nth-child(3) .rank { background: linear-gradient(135deg, #fdba74, #c2410c); color: #111; }
    .standings a { color: #fff; font-weight: 600; }
    .standings .pos { color: #6ee7b7; } .standings .neg { color: #fca5a5; }

    .empty-wrapper { padding: 3rem 1rem; text-align: center; color: var(--muted); }
    .empty-wrapper i { font-size: 2.2rem; color: var(--primary-light); margin-bottom: 0.75rem; display: block; }
    .match-col.is-hidden { display: none; }
</style>
{% endblock %}

{% macro status_key(statut) -%}
    {%- set s = statut|lower -%}
    {{- s in ['finished', 'terminé', 'termine'] ? 'finished' : (s in ['in progress', 'in_progress', 'en cours', 'live'] ? 'live' : (s in ['cancelled', 'canceled', 'annulé'] ? 'cancelled' : 'upcoming')) -}}
{%- endmacro %}

{% block body %}
{{ include('components/_page_hero.html.twig', {
    eyebrow: 'Match center',
    icon: 'fa-bolt',
    title: tournoi ? tournoi.nom : 'Match center',
    subtitle: tournoi ? 'Classement et matchs du tournoi' : 'Chaque match, chaque score, chaque victoire en temps réel.',
    image: 'img/web/crowd.jpg',
    actions: tournoi ? [{label: 'Voir le tournoi', url: path('app_tournoi_show', {id: tournoi.id}), icon: 'fa-trophy', style: 'outline'}] : []
}) }}

{% set labels = {live: 'En cours', upcoming: 'À venir', finished: 'Terminé', cancelled: 'Annulé'} %}
{% set badgeClass = {live: 'status-live', upcoming: 'bg-warning', finished: 'bg-success', cancelled: 'bg-secondary'} %}
{% set counts = {all: match_games|length, live: 0, upcoming: 0, finished: 0} %}
{% for m in match_games %}
    {% set k = _self.status_key(m.statut)|trim %}
    {% if counts[k] is defined %}{% set counts = counts|merge({(k): counts[k] + 1}) %}{% endif %}
{% endfor %}

<div class="container">
    {% if tournoi %}
        <section class="mb-5">
            <h2 class="h3 mb-3"><i class="fas fa-trophy mr-2" style="color:var(--warning)"></i>Classement</h2>
            {% if classement|default([])|length > 0 %}
                <div class="card" style="overflow-x:auto">
                    <table class="table table-hover standings mb-0">
                        <thead>
                            <tr><th>#</th><th>Équipe</th><th title="Matchs joués">MJ</th><th title="Victoires">V</th><th title="Nuls">N</th><th title="Défaites">D</th><th title="Buts pour">BP</th><th title="Buts contre">BC</th><th>Diff</th><th>Pts</th></tr>
                        </thead>
                        <tbody>
                            {% for row in classement %}
                                <tr>
                                    <td><span class="rank">{{ row.rang }}</span></td>
                                    <td><a href="{{ path('app_equipe_show', {'id': row.equipe.id}) }}">{{ row.equipe.nom }}</a></td>
                                    <td>{{ row.mj }}</td><td>{{ row.v }}</td><td>{{ row.n }}</td><td>{{ row.p }}</td>
                                    <td>{{ row.bp }}</td><td>{{ row.bc }}</td>
                                    <td class="{{ row.diff > 0 ? 'pos' : (row.diff < 0 ? 'neg') }}">{{ row.diff > 0 ? '+' }}{{ row.diff }}</td>
                                    <td><strong style="color:#fff">{{ row.pts }}</strong></td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="text-muted">Aucune équipe inscrite pour l'instant. Le classement s'affichera dès les premières inscriptions.</p>
            {% endif %}
        </section>
    {% endif %}

    <section>
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-2">
            <h2 class="h3 mb-0"><i class="fas fa-gamepad mr-2" style="color:var(--primary-light)"></i>Matchs</h2>
        </div>

        {% if match_games|length > 0 %}
            <div class="mc-filters" role="tablist" aria-label="Filtrer les matchs">
                <button type="button" class="mc-filter active" data-filter="all">Tous<span class="n">{{ counts.all }}</span></button>
                <button type="button" class="mc-filter" data-filter="live">En cours<span class="n">{{ counts.live }}</span></button>
                <button type="button" class="mc-filter" data-filter="upcoming">À venir<span class="n">{{ counts.upcoming }}</span></button>
                <button type="button" class="mc-filter" data-filter="finished">Terminés<span class="n">{{ counts.finished }}</span></button>
            </div>

            <div class="row g-4">
                {% for m in match_games %}
                    {% set key = _self.status_key(m.statut)|trim %}
                    {% set played = key in ['finished', 'live'] %}
                    {% set s1 = m.scoreTeam1 ?? 0 %}{% set s2 = m.scoreTeam2 ?? 0 %}
                    <div class="col-xl-4 col-md-6 match-col" data-status="{{ key }}">
                        <article class="card match">
                            <div class="match__head">
                                <span class="match__tournament" title="{{ m.tournoi.nom }}">{{ m.tournoi.jeu ? m.tournoi.jeu.nom ~ ' · ' }}{{ m.tournoi.nom }}</span>
                                <span class="match__date"><i class="far fa-clock mr-1"></i>{{ m.dateMatch ? m.dateMatch|date('d/m · H:i') : 'À définir' }}</span>
                            </div>
                            <div class="match__body">
                                {% for side in [{team: m.equipe1, mine: s1, other: s2}, {team: m.equipe2, mine: s2, other: s1}] %}
                                    {% if loop.index == 2 %}
                                        {% if played %}<div class="match__score">{{ s1 }} : {{ s2 }}</div>{% else %}<div class="match__vs">VS</div>{% endif %}
                                    {% endif %}
                                    <div class="match__team {{ key == 'finished' and side.mine > side.other ? 'win' : (key == 'finished' and side.mine < side.other ? 'lose') }}">
                                        {% if side.team.logo %}
                                            <img class="match__logo" src="{{ asset('uploads/teams/' ~ side.team.logo) }}" alt="" loading="lazy">
                                        {% else %}
                                            <span class="match__logo"><i class="fas fa-users"></i></span>
                                        {% endif %}
                                        <strong>{{ side.team.nom }}</strong>
                                    </div>
                                {% endfor %}
                            </div>
                            <div class="match__foot">
                                <span class="badge {{ badgeClass[key] }}">{{ labels[key] }}</span>
                                <a href="{{ path('app_match_game_show', {'id': m.id}) }}">Détails <i class="fas fa-arrow-right ml-1"></i></a>
                            </div>
                        </article>
                    </div>
                {% endfor %}
            </div>
            <p class="text-muted text-center mt-4 d-none" id="mc-empty">Aucun match dans cette catégorie.</p>
        {% else %}
            <div class="card empty-wrapper">
                <i class="fas fa-gamepad"></i>
                <h3 class="h5">Aucun match pour le moment</h3>
                <p class="mb-0">Les matchs apparaîtront ici dès qu'ils seront programmés.</p>
            </div>
        {% endif %}
    </section>
</div>

{% if tournoi %}
    {% include 'components/_chatbot_widget.html.twig' with {'tournoi_id': tournoi.id} %}
{% endif %}
{% endblock %}

{% block javascripts %}
<script>
document.querySelectorAll('.mc-filter').forEach(function (btn) {
    btn.addEventListener('click', function () {
        document.querySelectorAll('.mc-filter').forEach(function (b) { b.classList.toggle('active', b === btn); });
        var f = btn.dataset.filter, shown = 0;
        document.querySelectorAll('.match-col').forEach(function (col) {
            var show = f === 'all' || col.dataset.status === f;
            col.classList.toggle('is-hidden', !show);
            if (show) { shown++; col.classList.add('is-visible'); }
        });
        document.getElementById('mc-empty').classList.toggle('d-none', shown > 0);
    });
});
</script>
{% endblock %}
