{% extends 'admin/dashboard.html.twig' %}

{% block title %}Comments - Admin{% endblock %}

{% block admin_content %}


<div class="page-header">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="page-title">Comments Management</h1>
        </div>
        <a href="{{ path('admin_comment_new') }}" class="btn btn-primary">
            <i class="fas fa-plus-circle me-2"></i>New Comment
        </a>
    </div>
    
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="number">{{ total_comments|default(0) }}</div>
                <div class="label">Total Comments</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="number">{{ recent_comments|length }}</div>
                <div class="label">Recent</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="number">{{ comments|length }}</div>
                <div class="label">Displayed</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card">
                <div class="number">—</div>
                <div class="label">Placeholder</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Comments</h5>
        <div class="d-flex gap-2">
            <button class="btn btn-outline">
                <i class="fas fa-filter me-2"></i>Filter
            </button>
            <a href="{{ path('admin_comment_export_csv') }}" class="btn btn-outline">
                <i class="fas fa-download me-2"></i>Export
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Author</th>
                        <th>Blog</th>
                        <th>Content</th>
                        <th>Created At</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for comment in comments %}
                        <tr>
                            <td>#{{ comment.id }}</td>
                            <td>{{ comment.user ? (comment.user.nom ?: comment.user.email) : '—' }}</td>
                            <td>{{ comment.blog ? (comment.blog.title ?: '') : '' }}</td>
                            <td>{{ comment.content|length > 80 ? comment.content[:80] ~ '...' : comment.content }}</td>
                            <td>{{ comment.createdAt ? comment.createdAt|date('d M Y, H:i') : '' }}</td>
                            <td class="text-end">
                                <a href="{{ path('admin_comment_show', {'id': comment.id}) }}" class="action-btn view" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('admin_comment_edit', {'id': comment.id}) }}" class="action-btn edit" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="post" action="{{ path('admin_comment_delete', {'id': comment.id}) }}" class="d-inline" onsubmit="return confirm('Delete this comment?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                                    <button type="submit" class="action-btn delete" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-4">No comments found.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
