{# templates/profile/edit.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil — e-Sports.tn{% endblock %}

{% block body %}

<style>
body {
    background: radial-gradient(circle at 50% 0%, #0b0c17 0%, #1a1b2e 100%);
    color: #fff;
    font-family: 'Orbitron', sans-serif;
}

.profile-wrapper {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 50px;
}

.profile-card {
    background: #141528;
    border: 2px solid #6366f1;
    border-radius: 20px;
    width: 100%;
    max-width: 700px;
    padding: 50px;
    text-align: center;
    box-shadow: 0 0 30px rgba(99, 102, 241, 0.7);
    position: relative;
    overflow: hidden;
    transition: transform 0.3s ease;
}

.profile-card:hover {
    transform: scale(1.02);
    box-shadow: 0 0 50px rgba(99, 102, 241, 0.9);
}

.profile-avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 4px solid #6366f1;
    margin: 0 auto 20px;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    color: #fff;
    box-shadow: 0 0 20px #6366f1, 0 0 40px #6366f1 inset;
    animation: pulse 2s infinite alternate;
}

@keyframes pulse {
    0% { box-shadow: 0 0 20px #6366f1, 0 0 40px #6366f1 inset; }
    100% { box-shadow: 0 0 35px #22d3ee, 0 0 50px #22d3ee inset; }
}

.profile-card h2, .profile-card h3 {
    color: #fff;
    text-shadow: 0 0 10px #6366f1, 0 0 20px #22d3ee;
    margin-bottom: 25px;
}

.form-control {
    border-radius: 10px;
    border: none;
    padding: 12px 15px;
    margin-bottom: 20px;
    background: #1a1b2e;
    color: #fff;
    box-shadow: 0 0 10px rgba(99, 102, 241, 0.5) inset;
}

.form-control:focus {
    outline: none;
    box-shadow: 0 0 20px #6366f1 inset;
}

.btn-neon {
    display: inline-block;
    padding: 12px 25px;
    font-weight: bold;
    color: #fff;
    border-radius: 10px;
    margin: 10px 0;
    width: 100%;
    border: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    background: linear-gradient(90deg, #6366f1, #22d3ee);
    box-shadow: 0 0 10px #6366f1, 0 0 20px #22d3ee;
    transition: all 0.3s ease;
}

.btn-neon:hover {
    transform: scale(1.05);
    box-shadow: 0 0 20px #6366f1, 0 0 40px #22d3ee;
}
</style>
{{ include('components/_page_hero.html.twig', {
    eyebrow: 'Mon espace', icon: 'fa-user-edit',
    title: 'Modifier mon profil',
    subtitle: 'Mets à jour ton nom, ton email et ton mot de passe.',
    image: 'img/web/hero-gamer.jpg'
}) }}
<div class="profile-wrapper">
    <div class="profile-card">

        <div class="profile-avatar">{{ (app.user.nom ?? "?")|first|upper }}</div> 

        <h3>Modifier ton profil</h3>

        {{ form_start(profileForm) }}

        {{ form_widget(profileForm.nom, {'attr': {'class':'form-control', 'placeholder':'Nom complet'}}) }}
        {{ form_errors(profileForm.nom) }}

        {{ form_widget(profileForm.email, {'attr': {'class':'form-control', 'placeholder':'Email'}}) }}
        {{ form_errors(profileForm.email) }}

        {{ form_widget(profileForm.plainPassword, {'attr': {'class':'form-control', 'placeholder':'Laisse vide pour ne pas changer'}}) }}
        {{ form_help(profileForm.plainPassword) }}
        {{ form_errors(profileForm.plainPassword) }}

        <button type="submit" class="btn-neon">Enregistrer</button>

        {{ form_end(profileForm) }}

        <a href="{{ path('app_profile') }}" class="btn btn-neon mt-3" style="background: #555; box-shadow: 0 0 15px #999;">Retour au profil</a>

    </div>
</div>

{% endblock %}
