{# templates/profile/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mon profil — e-Sports.tn{% endblock %}

{% block body %}

<style>
body {
    background: radial-gradient(circle at 50% 0%, #0b0c17 0%, #1a1b2e 100%);
    color: #fff;
    font-family: 'Orbitron', sans-serif;
}

.profile-wrapper {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 50px;
}

.profile-card {
    background: #141528;
    border: 2px solid #6366f1;
    border-radius: 20px;
    width: 100%;
    max-width: 700px;
    padding: 50px;
    text-align: center;
    box-shadow: 0 0 30px rgba(99, 102, 241, 0.7);
    position: relative;
    overflow: hidden;
    transition: transform 0.3s ease;
}

.profile-card:hover {
    transform: scale(1.02);
    box-shadow: 0 0 50px rgba(99, 102, 241, 0.9);
}

/* Neon Avatar */
.profile-avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 4px solid #6366f1;
    margin: 0 auto 20px;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    color: #fff;
    box-shadow: 0 0 20px #6366f1, 0 0 40px #6366f1 inset;
    animation: pulse 2s infinite alternate;
}

@keyframes pulse {
    0% { box-shadow: 0 0 20px #6366f1, 0 0 40px #6366f1 inset; }
    100% { box-shadow: 0 0 35px #22d3ee, 0 0 50px #22d3ee inset; }
}

/* Neon Text */
.profile-card h2, .profile-card h4 {
    color: #fff;
    text-shadow: 0 0 10px #6366f1, 0 0 20px #22d3ee;
}

.profile-card p {
    color: #aaa;
    margin-bottom: 20px;
}

/* Buttons */
.btn-neon {
    display: inline-block;
    padding: 12px 25px;
    font-weight: bold;
    color: #fff;
    border-radius: 10px;
    margin: 10px 0;
    width: 100%;
    border: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    background: linear-gradient(90deg, #6366f1, #22d3ee);
    box-shadow: 0 0 10px #6366f1, 0 0 20px #22d3ee;
    transition: all 0.3s ease;
}

.btn-neon:hover {
    transform: scale(1.05);
    box-shadow: 0 0 20px #6366f1, 0 0 40px #22d3ee;
}
</style>
{{ include('components/_page_hero.html.twig', {
    eyebrow: 'Mon espace', icon: 'fa-user',
    title: 'Mon profil',
    subtitle: 'Gère ton compte, ta sécurité et tes équipes.',
    image: 'img/web/hero-gamer.jpg'
}) }}
<div class="profile-wrapper">
    <div class="profile-card">

        {# Avatar #}
        <div class="profile-avatar">{{ (app.user.nom ?? "?")|first|upper }}</div>

        {# User Name #}
        <h2>{{ app.user.nom ?? 'No Name' }}</h2>

        {# User Email #}
        <p>{{ app.user.email ?? 'No Email' }}</p>

        {# Role Badge #}
        <span class="badge bg-success mb-3">
            {{ 'ROLE_ADMIN' in app.user.roles ? 'ADMIN' : 'JOUEUR' }}
        </span>

        <hr style="border-color: #6366f1;">

        {# Edit Profile Button #}
        <a href="{{ path('app_profile_edit') }}" class="btn btn-neon mb-2">
            Modifier le profil
        </a>

        {# Logout Button #}
        <a href="{{ path('app_logout') }}" class="btn btn-neon">
            Déconnexion
        </a>

        <hr style="border-color: #6366f1; margin: 30px 0;">

        {# 2FA Section #}
        <h4>Two-Factor Authentication</h4>
        
        {% if app.user.is2faEnabled() %}
            <p class="text-success">✅ 2FA activée</p>
            <a href="{{ path('app_2fa_disable') }}" class="btn btn-neon" style="background: linear-gradient(90deg, #dc3545, #c82333);">
                Désactiver la 2FA
            </a>
        {% else %}
            <p class="text-warning">⚠️ 2FA non activée</p>
            <a href="{{ path('app_2fa_setup') }}" class="btn btn-neon">
                Activer la 2FA
            </a>
        {% endif %}

        <hr style="border-color: #6366f1; margin: 30px 0;">

        {# Face Recognition Section #}
        <h4>Face Recognition</h4>
        
        {% if app.user.isFaceEnabled() %}
            <p class="text-success">✅ Reconnaissance faciale activée</p>
            <a href="{{ path('app_face_enroll') }}" class="btn btn-neon">
                Mettre à jour le visage
            </a>
        {% else %}
            <p class="text-warning">⚠️ Reconnaissance faciale non activée</p>
            <a href="{{ path('app_face_enroll') }}" class="btn btn-neon">
                Activer la reconnaissance faciale
            </a>
        {% endif %}

    </div>
</div>

{% endblock %}
