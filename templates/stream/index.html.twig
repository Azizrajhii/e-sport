{% extends 'base.html.twig' %}

{% block title %}Live — e-Sports.tn{% endblock %}

{# Uploaded videos are stored as file names (VichUploader "stream_video" mapping); external streams are full URLs #}
{% macro video_src(url) -%}
    {{- url starts with 'http' or url starts with '/' ? url : asset('uploads/videos/' ~ url) -}}
{%- endmacro %}

{% block stylesheets %}
<style>
    .live-layout { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 1.5rem; align-items: start; }

    .player { position: relative; overflow: hidden; border-radius: var(--radius); background: #000; aspect-ratio: 16 / 9; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5); }
    .player video { width: 100%; height: 100%; display: block; object-fit: contain; background: #000; }
    .player__badge { position: absolute; top: 14px; left: 14px; z-index: 2; display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.75rem; border-radius: 8px; background: rgba(239, 68, 68, 0.92); color: #fff; font-weight: 700; font-size: 0.75rem; letter-spacing: 0.1em; }
    .player__badge .live-dot { background: #fff; }
    .player-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1rem; }
    .player-meta h2 { font-size: 1.5rem; margin: 0; }
    .player-meta small { color: var(--muted); }

    .reactions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .reaction-btn { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.5rem 0.9rem; border-radius: 999px; border: 1px solid var(--border-strong); background: rgba(148, 163, 184, 0.08); color: var(--text); font-weight: 600; transition: transform 0.15s var(--ease), border-color 0.2s, background 0.2s; }
    .reaction-btn:hover { border-color: var(--primary); background: rgba(99, 102, 241, 0.15); }
    .reaction-btn:active { transform: scale(0.92); }
    .reaction-btn .n { color: var(--muted); font-weight: 500; font-variant-numeric: tabular-nums; }
    .reaction-btn.pop { animation: bump 0.45s var(--ease); }

    .chat { display: flex; flex-direction: column; height: 100%; max-height: 560px; }
    .chat__head { padding: 1rem 1.25rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
    .chat__head h3 { font-size: 1rem; margin: 0; }
    .chat__list { flex: 1; overflow-y: auto; padding: 1rem 1.25rem; display: grid; gap: 0.75rem; align-content: start; min-height: 220px; }
    .chat__msg { display: flex; gap: 0.6rem; animation: toast-in 0.35s var(--ease) both; }
    .chat__avatar { flex: 0 0 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; font-size: 0.75rem; font-weight: 700; color: #fff; background: var(--grad); }
    .chat__msg strong { display: block; color: #c7d2fe; font-size: 0.8rem; }
    .chat__msg p { margin: 0; font-size: 0.9rem; word-break: break-word; }
    .chat__empty { color: var(--muted); font-size: 0.9rem; text-align: center; padding: 2rem 0; }
    .chat__form { display: flex; gap: 0.5rem; padding: 1rem 1.25rem; border-top: 1px solid var(--border); }
    .chat__form input { flex: 1; min-width: 0; padding: 0.6rem 0.9rem; }

    .no-live { padding: 3rem 1.5rem; text-align: center; }
    .no-live i { font-size: 2.5rem; color: var(--primary-light); margin-bottom: 1rem; }

    .vod-card { overflow: hidden; }
    .vod-card video { width: 100%; aspect-ratio: 16 / 9; display: block; background: #000; }
    .vod-card__body { padding: 0.9rem 1rem 1rem; display: grid; gap: 0.6rem; }
    .vod-card__body strong { color: #fff; font-size: 0.95rem; }
    .vod-card .reaction-btn { padding: 0.35rem 0.7rem; font-size: 0.85rem; }

    @media (max-width: 991.98px) { .live-layout { grid-template-columns: 1fr; } .chat { max-height: 460px; } }
</style>
{% endblock %}

{% block body %}
{{ include('components/_page_hero.html.twig', {
    eyebrow: 'En direct',
    icon: 'fa-broadcast-tower',
    title: 'Live streaming',
    subtitle: 'Regarde les matchs en direct et réagis avec la communauté.',
    image: 'img/web/live-studio.jpg'
}) }}

{% set reactionTypes = {adore: '❤️', aime: '👍', bravo: '👏'} %}

<div class="container">
    {% if activeStream %}
        <div class="live-layout">
            <div>
                <div class="player glow-border">
                    <span class="player__badge"><span class="live-dot"></span> EN DIRECT</span>
                    <video id="active-video" controls autoplay muted playsinline></video>
                </div>
                <div class="player-meta">
                    <div>
                        {% set match = activeStream.matchGame %}
                        <h2>{{ match ? match.equipe1.nom ~ ' vs ' ~ match.equipe2.nom : 'Live' }}</h2>
                        <small>{{ match and match.tournoi ? match.tournoi.nom : 'Diffusion en cours' }}</small>
                    </div>
                    <div class="reactions" id="reaction-count-{{ activeStream.id }}">
                        {% for type, emoji in reactionTypes %}
                            <button type="button" class="reaction-btn" data-stream="{{ activeStream.id }}" data-type="{{ type }}">
                                {{ emoji }} <span class="n">{{ activeStream.reactions|filter(r => r.type == type)|length }}</span>
                            </button>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <aside class="card chat">
                <div class="chat__head">
                    <h3><i class="fas fa-comments mr-2" style="color:var(--primary-light)"></i>Chat du live</h3>
                    <small class="text-muted">{{ activeStream.reactions|filter(r => r.comment)|length }} messages</small>
                </div>
                <div class="chat__list" id="reaction-list">
                    {% for reaction in activeStream.reactions|filter(r => r.comment) %}
                        <div class="chat__msg">
                            <span class="chat__avatar">{{ reaction.username|first|upper }}</span>
                            <div><strong>{{ reaction.username|split('@')|first }}</strong><p>{{ reaction.comment }}</p></div>
                        </div>
                    {% else %}
                        <p class="chat__empty" id="chat-empty">Sois le premier à écrire dans le chat !</p>
                    {% endfor %}
                </div>
                <form class="chat__form" id="reaction-form">
                    <input type="text" id="comment" class="form-control" placeholder="Écrire un message…" maxlength="300" aria-label="Message" required>
                    <button type="submit" class="btn btn-primary" aria-label="Envoyer"><i class="fas fa-paper-plane"></i></button>
                </form>
            </aside>
        </div>
    {% else %}
        <div class="card no-live">
            <i class="fas fa-video-slash d-block"></i>
            <h2 class="h4">Aucun live pour le moment</h2>
            <p class="text-muted mb-0">Reviens pendant les matchs des tournois, ou regarde les rediffusions ci-dessous.</p>
        </div>
    {% endif %}

    <div class="section-head d-flex flex-wrap align-items-end justify-content-between gap-2 mt-5 mb-3">
        <h2 class="h3 mb-0">Rediffusions</h2>
        <small class="text-muted">{{ videos|length }} vidéo(s)</small>
    </div>
    <div class="row g-4">
        {% for video in videos %}
            {% set match = video.matchGame %}
            <div class="col-lg-4 col-md-6">
                <article class="card vod-card">
                    <video controls preload="metadata" playsinline>
                        <source src="{{ _self.video_src(video.url) }}" type="video/mp4">
                    </video>
                    <div class="vod-card__body">
                        <strong>{{ match ? match.equipe1.nom ~ ' vs ' ~ match.equipe2.nom : 'Vidéo' }}</strong>
                        <div class="reactions" id="reaction-count-{{ video.id }}">
                            {% for type, emoji in reactionTypes %}
                                <button type="button" class="reaction-btn" data-stream="{{ video.id }}" data-type="{{ type }}">
                                    {{ emoji }} <span class="n">{{ video.reactions|filter(r => r.type == type)|length }}</span>
                                </button>
                            {% endfor %}
                        </div>
                    </div>
                </article>
            </div>
        {% else %}
            <div class="col-12"><p class="text-muted">Aucune rediffusion disponible.</p></div>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.13/dist/hls.min.js"></script>
<script>
(function () {
    const csrfToken = '{{ csrf_token('stream_react') }}';

    {% if activeStream %}
    // Player: HLS for .m3u8 streams, native playback for uploaded files
    const video = document.getElementById('active-video');
    const src = '{{ _self.video_src(activeStream.url)|e('js') }}';
    if (/\.m3u8(\?|$)/.test(src) && window.Hls && Hls.isSupported()) {
        const hls = new Hls();
        hls.loadSource(src);
        hls.attachMedia(video);
    } else {
        video.src = src;
    }
    {% endif %}

    function sendReaction(streamId, type, comment) {
        return fetch('/stream/react/' + streamId, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken },
            body: JSON.stringify({ type: type, comment: comment || null })
        }).then(function (res) { return res.json(); });
    }

    // Reaction buttons (live + replays)
    document.addEventListener('click', function (e) {
        const btn = e.target.closest('.reaction-btn');
        if (!btn) return;
        sendReaction(btn.dataset.stream, btn.dataset.type).then(function (data) {
            if (data.error) return;
            btn.querySelector('.n').textContent = data.count;
            btn.classList.remove('pop'); void btn.offsetWidth; btn.classList.add('pop');
        }).catch(function () {});
    });

    // Chat (text is inserted with textContent: viewers cannot inject HTML)
    const form = document.getElementById('reaction-form');
    if (form) {
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            const input = document.getElementById('comment');
            const comment = input.value.trim();
            if (!comment) return;
            sendReaction({{ activeStream ? activeStream.id : 'null' }}, 'comment', comment).then(function (data) {
                if (data.error) return;
                const empty = document.getElementById('chat-empty');
                if (empty) empty.remove();
                const name = String(data.username || 'Moi').split('@')[0];
                const msg = document.createElement('div');
                msg.className = 'chat__msg';
                msg.innerHTML = '<span class="chat__avatar"></span><div><strong></strong><p></p></div>';
                msg.querySelector('.chat__avatar').textContent = name.charAt(0).toUpperCase();
                msg.querySelector('strong').textContent = name;
                msg.querySelector('p').textContent = data.comment || comment;
                const list = document.getElementById('reaction-list');
                list.appendChild(msg);
                list.scrollTop = list.scrollHeight;
                input.value = '';
            }).catch(function () {});
        });
    }
})();
</script>
{% endblock %}
